# ===== Flask 安全配置 =====
# 务必设置固定值，否则每次重启所有用户 session 失效
SECRET_KEY=generate-using-python-secrets-token-hex-32

# ===== API Key 加密密钥 =====
# 用于加密数据库中存储的 AI API Key（OpenAI/DeepSeek 等）
# 不设置则回退使用 SECRET_KEY 作为加密种子
API_ENCRYPTION_KEY=

# ===== 管理员初始密码（仅首次初始化时使用） =====
# 不设置则自动生成 16 位随机密码并打印到控制台
ADMIN_INITIAL_PASSWORD=

# ===== 数据库配置 =====
DATABASE_URL=sqlite:///oa.db

# ===== 上传配置 =====
MAX_CONTENT_LENGTH=1073741824

# ===== LibreOffice 路径（文档转换） =====
# 不设置则自动搜索常见路径
SOFFICE_PATH=

# ===== 日志级别 =====
LOG_LEVEL=INFO

# ===== Flask 运行配置 =====
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# ===== Session 有效期（秒），默认 7 天 =====
SESSION_LIFETIME=604800
